{
  "name": "snapdle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:deploy": "pnpm build && rm -f dist/assets/*.wasm",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "preview": "vite preview",
    "smoke:browser": "tsx scripts/smoke-browser.ts",
    "e2e": "pnpm build && E2E_BROWSER=\"${E2E_BROWSER:-$(command -v helium || true)}\" playwright test",
    "plan": "alchemy plan --stage prod",
    "deploy": "alchemy deploy --stage prod",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm format && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@effect/platform-node": "^4.0.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "alchemy": "2.0.0-beta.81",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "effect": "^4.0.2",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.4",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1"
}
